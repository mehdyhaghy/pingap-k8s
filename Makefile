CHART       := charts/pingap-k8s
MANIFESTS   := deploy/pingap-k8s.yaml
# Namespace baked into the plain manifests.
NAMESPACE   ?= pingap-k8s
IMAGE       ?= pingap-k8s:dev
PLATFORMS   ?= linux/amd64,linux/arm64

.PHONY: all fmt fmt-check clippy test deny check helm-lint helm-template exposure-check version-check manifests manifests-check docker docker-multiarch

all: check

fmt:
	cargo fmt --all

fmt-check:
	cargo fmt --all -- --check

clippy:
	cargo clippy --all-targets --locked -- -D warnings

test:
	cargo test --locked

# Dependency licenses (CNCF allowlist) and sources; needs cargo-deny.
deny:
	cargo deny --locked check licenses sources

check: fmt-check clippy test helm-lint helm-template exposure-check version-check manifests-check

# Lint the chart with the default values and with each ci/*-values.yaml.
helm-lint:
	helm lint $(CHART)
	@for f in $(CHART)/ci/*-values.yaml; do \
		echo "helm lint -f $$f"; \
		helm lint $(CHART) -f $$f || exit 1; \
	done

# Render the chart with the default values and with each ci/*-values.yaml.
helm-template:
	helm template pingap-k8s $(CHART) --namespace $(NAMESPACE) > /dev/null
	@for f in $(CHART)/ci/*-values.yaml; do \
		echo "helm template -f $$f"; \
		helm template pingap-k8s $(CHART) --namespace $(NAMESPACE) -f $$f > /dev/null || exit 1; \
	done

# Nothing but the quickstart proxy Service may leave the cluster (it is forced to
# ClusterIP here), for every values file. RBAC is namespaced, except the
# `<release>-gateway` ClusterRole of the Gateway API provider (gateway.enabled):
# fail on any other cluster-wide RBAC, and on that one if it grants anything on
# secrets or any write besides patch.
exposure-check:
	@for f in "" $(CHART)/ci/*-values.yaml; do \
		out=$$(helm template pingap-k8s $(CHART) $${f:+-f $$f} --set pingap.service.type=ClusterIP) || exit 1; \
		if echo "$$out" | grep -nE 'type: (LoadBalancer|NodePort)'; then \
			echo "a Service is exposed outside the cluster ($${f:-default values})" >&2; exit 1; \
		fi; \
		cluster=$$(echo "$$out" | yq 'select(.kind == "ClusterRole" or .kind == "ClusterRoleBinding")'); \
		names=$$(echo "$$cluster" | yq '.metadata.name' | grep -vxE -- '---|null' | sort -u); \
		if [ -n "$$names" ] && [ "$$names" != "pingap-k8s-gateway" ]; then \
			echo "cluster-wide RBAC other than the gateway ClusterRole rendered ($${f:-default values}): $$names" >&2; exit 1; \
		fi; \
		if echo "$$cluster" | yq '.rules[]? | (.resources[], .verbs[])' | grep -nxE 'secrets|create|update|delete|deletecollection|escalate|bind|impersonate|\*'; then \
			echo "the gateway ClusterRole grants more than reads and status patches ($${f:-default values})" >&2; exit 1; \
		fi; \
	done; echo "exposure-check: ok"

# The version is the Pingap version in the chart values plus one release digit
# (Pingap 0.16.1: 0.16.10 to 0.16.19), the same in Cargo.toml and Chart.yaml.
version-check:
	@echo "version-check: $$(scripts/check-version.sh)"

# Regenerate the plain manifests from the chart with the default values.
manifests:
	@mkdir -p deploy
	@{ \
		echo "# pingap-k8s plain manifests, generated by 'make manifests' from $(CHART)"; \
		echo "# with the default values. Do not edit by hand: change the chart and regenerate."; \
		echo "#"; \
		echo "# Before applying: create the namespace, edit the etcd URL in the ConfigMap, the"; \
		echo "# upstreams, and add a Role + RoleBinding for every namespace your Services are in."; \
		echo "#   kubectl create namespace $(NAMESPACE)"; \
		echo "#   kubectl apply -f $(MANIFESTS)"; \
		helm template pingap-k8s $(CHART) --namespace $(NAMESPACE); \
	} > $(MANIFESTS)
	@echo "wrote $(MANIFESTS)"

# Fail when deploy/ is out of date with the chart.
manifests-check: manifests
	git diff --exit-code -- $(MANIFESTS)

docker:
	docker build -t $(IMAGE) .

docker-multiarch:
	docker buildx build --platform $(PLATFORMS) -t $(IMAGE) .
