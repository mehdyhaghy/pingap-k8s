# ---------------------------------------------------------------------------
# Rust
# ---------------------------------------------------------------------------
/target/
**/target/
**/*.rs.bk
*.pdb
# Cargo.lock is committed: this is a binary crate.

# Coverage, profiling, benchmarks (scripts/bench-local.sh keeps results in target/bench/)
*.profraw
*.profdata
lcov.info
coverage/
tarpaulin-report.*
cobertura.xml
flamegraph.svg
perf.data
perf.data.old
criterion/
# cargo-llvm-cov / cargo-mutants / nextest outputs
/coverage-html/
mutants.out/
mutants.out.old/
junit.xml

# Fuzzing
/fuzz/target/
/fuzz/corpus/
/fuzz/artifacts/

# ---------------------------------------------------------------------------
# Secrets and credentials (never commit)
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.csr
*.p12
*.pfx
*.jks
*.keystore
*.der
!**/testdata/**/*.pem
!**/testdata/**/*.key
!**/testdata/**/*.crt
secrets/
*.secret.yaml
*.secret.yml
*-secret.yaml
*-secret.yml
# Chart templates are source, never secrets themselves.
!charts/**/templates/*.yaml
!charts/**/templates/*.tpl
kubeconfig
kubeconfig*
*.kubeconfig
.kube/
etcd-certs/
id_rsa*
id_ed25519*
.netrc
.htpasswd
.npmrc
.pypirc
.cargo/credentials
.cargo/credentials.toml
.docker/config.json
credentials.json
*.age
*.gpg
*.asc
!KEYS.asc
# Pingap admin passwords and etcd client TLS material fetched for local testing
admin-password*
*.p8
# Cloud, registry and signing credentials
.aws/
.azure/
.gcloud/
gha-creds-*.json
*service-account*.json
.vault-token
.git-credentials
.ssh/
known_hosts
*.ovpn
*.kdbx
cosign.key
*.sigstore.json
# Local GitHub Actions runs (act)
.secrets
.actrc
# HTTP captures and dumps can hold tokens and cookies
*.har
core
core.[0-9]*
*.dmp
dhat-heap.json
heaptrack.*
# etcd snapshots and local databases hold the full Pingap config
*.snapshot
snapshot.db
*.sqlite
*.sqlite3

