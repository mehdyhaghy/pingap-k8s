default.etcd/
*.etcd/
etcd-data/

# Release staging (plugin tarballs, checksums, rendered manifests; see release.yml)
/dist/
/staging/
*.tar.gz
*.tar.gz.sha256
kubectl-pingap_*_checksums.txt
# SBOMs, provenance and scan reports generated locally
*.spdx.json
*.cdx.json
*.intoto.jsonl
*.sarif

# ---------------------------------------------------------------------------
# Container builds
# ---------------------------------------------------------------------------
.docker/
docker-compose.override.yml
*.tar
!**/testdata/**/*.tar

