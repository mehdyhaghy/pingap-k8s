# Kubernetes / Helm / kind
# ---------------------------------------------------------------------------
charts/*/charts/
charts/*/Chart.lock
charts/*/tmpcharts/
*.tgz
!charts/**/testdata/*.tgz
helm-output/
rendered/
kind-config.local.yaml
values.local.yaml
values-*.local.yaml
*.local.toml

